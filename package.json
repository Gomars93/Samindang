{
  "name": "samindang-questionnaire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test:integration": "esbuild src/spec/coreSpec.ts --bundle --format=esm --outfile=tests/.spec-bundle.mjs --platform=neutral && node tests/integration.spec.mjs",
    "test:layout": "esbuild src/spec/coreSpec.ts --bundle --format=esm --outfile=tests/.spec-bundle.mjs --platform=neutral && node tests/layout-budget.spec.mjs",
    "test:saju": "esbuild src/saju/index.ts --bundle --format=esm --outfile=tests/.saju-bundle.mjs --platform=neutral && node tests/saju.spec.mjs",
    "test:doctor": "esbuild src/doctor/fixtures.ts --bundle --format=esm --outfile=tests/.doctor-fixtures-bundle.mjs --platform=neutral && esbuild src/doctor/labels.ts --bundle --format=esm --outfile=tests/.doctor-labels-bundle.mjs --platform=neutral && node tests/doctor.spec.mjs",
    "test:all": "npm run test:integration && npm run test:layout && npm run test:saju && npm run test:doctor"
  },
  "dependencies": {
    "manseryeok": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openai": "^7.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
