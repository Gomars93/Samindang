node_modules
dist
.vite
*.local

# env / secrets (future OpenAI API key etc.)
.env
.env.*

# task queue runtime state (regenerated by verify-queue.js, not source)
.claude/queue/state.json
.claude/queue/reports/*
!.claude/queue/reports/.gitkeep

# local queue loop-fix scratch artifacts (user-generated, not source)
*.bak-before-loopfix
fix-samindang-queue-loop.ps1

# esbuild bundle used by tests/integration.spec.mjs (regenerated, not source)
tests/.spec-bundle.mjs

# esbuild bundle used by tests/saju.spec.mjs (regenerated, not source)
tests/.saju-bundle.mjs

# esbuild bundles used by tests/doctor.spec.mjs (regenerated, not source)
tests/.doctor-fixtures-bundle.mjs
tests/.doctor-labels-bundle.mjs
tests/.doctor-judgment-bundle.mjs
tests/.doctor-sectionorder-bundle.mjs
tests/.doctor-view-bundle.cjs

# esbuild bundles used by tests/patient-flow.spec.mjs (regenerated, not source)
tests/.patient-complete-bundle.cjs
tests/.idle-warning-bundle.cjs

# esbuild bundle used by tests/emrSummary.spec.mjs (regenerated, not source)
tests/.emr-summary-bundle.mjs

# TypeScript incremental build artifacts
*.tsbuildinfo

# runtime patient data written by server/index.js (SAMINDANG_DATA_DIR default) —
# never commit real submissions. This also covers .data/audit.log (the
# operational audit log, see server/audit.js) — already caught by the
# directory rule below, listed explicitly for clarity.
.data/
.data/audit.log
